      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "DLQ Poison Pills",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(dlq_poison_pill_total[5m]))",
