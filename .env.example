# Kafka broker connection for local development.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Schema Registry endpoint used by the Avro producers and consumers.
SCHEMA_REGISTRY_URL=http://localhost:8081

# Uncomment for cloud deployment and set the appropriate mechanism.
# KAFKA_SASL_MECHANISM=PLAIN

# Use PLAINTEXT for local development; switch to SASL_SSL in production.
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# PostgreSQL connection details for the sink.
POSTGRES_DSN=postgresql://streaming_user:changeme@localhost:5432/streaming_db
POSTGRES_MAX_CONNECTIONS=20

# Redis connection details for real-time state.
REDIS_URL=redis://localhost:6379
REDIS_MAX_CONNECTIONS=50

# Flink job tuning.
FLINK_PARALLELISM=4
CHECKPOINT_INTERVAL_MS=60000

# Stream processing thresholds and topic routing.
ANOMALY_ZSCORE_THRESHOLD=3.0
WINDOW_SIZE_SECONDS=60
DLQ_TOPIC=dlq.failed.events

# Monitoring credentials.
GRAFANA_ADMIN_PASSWORD=changeme